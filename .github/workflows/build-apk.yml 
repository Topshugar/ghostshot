name: Build GhostShot APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Create Android project
        run: |
          mkdir -p app/src/main/assets
          mkdir -p app/src/main/java/com/ghostshot/app
          cp index.html app/src/main/assets/index.html

          cat > app/build.gradle << 'EOF'
          plugins { id 'com.android.application' }
          android {
            namespace 'com.ghostshot.app'
            compileSdk 34
            defaultConfig {
              applicationId "com.ghostshot.app"
              minSdk 24
              targetSdk 34
              versionCode 1
              versionName "1.0"
            }
            buildTypes { release { minifyEnabled false } }
          }
          EOF

          cat > settings.gradle << 'EOF'
          include ':app'
          EOF

          cat > app/src/main/AndroidManifest.xml << 'EOF'
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">
            <application android:label="GhostShot" android:theme="@android:style/Theme.Material">
              <activity android:name=".MainActivity" android:exported="true">
                <intent-filter>
                  <action android:name="android.intent.action.MAIN" />
                  <category android:name="android.intent.category.LAUNCHER" />
                </intent-filter>
              </activity>
            </application>
          </manifest>
          EOF

          cat > app/src/main/java/com/ghostshot/app/MainActivity.java << 'EOF'
          package com.ghostshot.app;
          import android.app.Activity;
          import android.os.Bundle;
          import android.webkit.WebView;
          import android.webkit.WebSettings;
          public class MainActivity extends Activity {
            @Override protected void onCreate(Bundle s) {
              super.onCreate(s);
              WebView web = new WebView(this);
              WebSettings st = web.getSettings();
              st.setJavaScriptEnabled(true);
              st.setDomStorageEnabled(true);
              web.loadUrl("file:///android_asset/index.html");
              setContentView(web);
            }
          }
          EOF

      - name: Build APK
        run: |
          chmod +x gradlew || true
          ./gradlew assembleDebug || ./gradlew assembleDebug --info

      - name: Upload APK as Artifact
        uses: actions/upload-artifact@v4
        with:
          name: ghostshot-apk
          path: app/build/outputs/apk/debug/app-debug.apk

      - name: Create Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.0.${{ github.run_number }}
          name: GhostShot v1.0.${{ github.run_number }}
          files: app/build/outputs/apk/debug/app-debug.apk
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}